#!/usr/bin/env bash
# rol: git hook pre-push — gate completo antes de pushear a main/develop.
# Corre el CI LOCAL completo (incluye mutation + act). Bloquea si falla.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Solo en pushes a main/develop (los feature/* pueden ir más rápido)
BRANCH="${1:-}"
case "$BRANCH" in
  refs/heads/main|refs/heads/develop)
    echo "▶ pre-push: CI LOCAL completo (main/develop)"
    ./scripts/ci-local.sh
    echo "✓ pre-push OK"
    ;;
  *)
    echo "▶ pre-push: solo tests (rama no protegida)"
    pnpm test
    ;;
esac
