{
  "name": "netrunner",
  "version": "0.1.0",
  "type": "module",
  "description": "Universal agent SDK — plug any project into any agent.",
  "license": "MIT",
  "bin": {
    "netrunner": "./dist/netrunner"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "stryker run",
    "build": "bun build --compile --minify --bytecode --target=bun-linux-x64 ./src/cli.ts --outfile dist/netrunner",
    "build:matrix": "./scripts/build-matrix.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/vitest-runner": "^9.0.0",
    "@types/bun": "^1.1.0"
  }
}
