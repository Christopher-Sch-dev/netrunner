{
  "name": "netrunner",
  "version": "0.1.0",
  "type": "module",
  "description": "Universal agent SDK — plug any project into any agent.",
  "license": "MIT",
  "bin": {
    "netrunner": "./dist/netrunner"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "stryker run",
    "build": "bun build --compile --minify --bytecode --target=bun-linux-x64 ./src/cli.ts --outfile dist/netrunner",
    "build:matrix": "./scripts/build-matrix.sh"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/vitest-runner": "^9.0.0",
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.4.3"
  }
}
